APP_NAME="Pioneers Edu API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.pioneersedu.com
FRONTEND_URL=https://courseenglish.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

# --- Local development (SQLite, no XAMPP) ---
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/Backendupdate/database/database.sqlite
# APP_ENV=local
# APP_DEBUG=true
# APP_URL=http://127.0.0.1:8000
# FRONTEND_URL=http://localhost:3000
# MAIL_MAILER=log

# --- Production (Namecheap shared hosting) ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=pionueoc_backend
DB_USERNAME=pionueoc_backend
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=database

# Public catalog API JSON cache (file on disk — schools, courses, etc.; not auth/booking)
API_RESPONSE_CACHE_ENABLED=true
API_RESPONSE_CACHE_STORE=api_responses
API_RESPONSE_CACHE_TTL=2592000

# CORS — comma-separated production + local dev origins
CORS_ALLOWED_ORIGINS=https://courseenglish.com,https://www.courseenglish.com,http://localhost:3000

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=booking@pioneersedu.com
MAIL_FROM_NAME="${APP_NAME}"

EXCHANGE_RATE_API_BASE_URL=
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_TARGET_CURRENCIES=SAR,GBP,USD,EUR
EXCHANGE_RATE_REFRESH_TIME=06:00
