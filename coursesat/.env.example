# Production (Vercel) — courseenglish.com
# Browser uses same-origin /api via rewrites; optional direct API URL:

# NEXT_PUBLIC_API_BASE_URL=https://app.pioneersedu.com/api
# NEXT_PUBLIC_BACKEND_URL=https://app.pioneersedu.com

# Server-only: used by next.config.mjs rewrites (set in Vercel dashboard)
BACKEND_ORIGIN=https://app.pioneersedu.com

# On Vercel, rewrites also exist in vercel.json → app.pioneersedu.com (works even if this is unset at build)

# Local development
# BACKEND_ORIGIN=http://127.0.0.1:8000
